# Application Name
APP_NAME="App Name"""
# Application Environment (local, production, etc.)
APP_ENV=local
# Application Key (set via `php artisan key:generate`)
APP_KEY=
# Debug Mode (true/false)
APP_DEBUG=true
# Application Timezone
APP_TIMEZONE=UTC
# Application URL
APP_URL=http://localhost
APP_BASE_DOMAIN=localhost.dev

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode Driver
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=Database

# PHP CLI Server Workers
# PHP_CLI_SERVER_WORKERS=4

# Hashing
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN=null

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Queue
QUEUE_CONNECTION=database

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (S3) Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Filament Admin Path
FILAMENT_PATH=admin

# Tenancy Configuration
# Main domain for the application (without subdomain)
# Example: stopit.dev
# Tenant subdomains will be: gitman.stopit.dev, spotivel.stopit.dev, etc.
TENANT_CENTRAL_DOMAIN=localhost.dev
